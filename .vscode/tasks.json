{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Makefile",
            "type": "shell",
            "command": "make",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++-23 build project",
            "command": "/opt/homebrew/bin/g++-23",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-Wall",
                "-I${workspaceFolder}/include",       // Finds your Entity/class headers
                "-I/opt/homebrew/include",            // Finds SDL3 headers
                "${workspaceFolder}/main.cpp",        // Compiles main.cpp in root
                "${workspaceFolder}/src/*.cpp",       // Compiles all .cpp files in src/
                "-o",
                "${workspaceFolder}/main",            // Outputs executable to root
                "-L/opt/homebrew/lib",                // Finds SDL3 libraries
                "-Wl,-rpath,/opt/homebrew/lib",
                "-lSDL3"                              // Links SDL3
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles main.cpp, src folder, and links SDL3."
        }
    ]
}
